# Copy this file to .env and fill in the values (see README).

# From https://developer.tidal.com → your app → Credentials
TIDAL_CLIENT_ID=
# Only if the TIDAL portal shows one for your app; leave empty otherwise
TIDAL_CLIENT_SECRET=
# Country used for catalog lookups until a TIDAL account is connected
TIDAL_COUNTRY=US

# From https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# Claude model used for playlist research
CLAUDE_MODEL=claude-opus-5

# The address you open the app at. Must match the redirect URI registered on TIDAL
# (this address + /tidal/callback).
BASE_URL=http://localhost:8000
